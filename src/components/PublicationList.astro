---
// The Publications list: newest first, grouped under red year markers, with
// topic buttons that filter it. The filter is a few lines of plain JS; with
// JavaScript off the buttons never appear and the full list is shown.
import PublicationEntry from './PublicationEntry.astro';
import { slug, type Publication } from '../data/site';

interface Props {
  publications: Publication[];
}
const { publications } = Astro.props;

// Newest first. Array.sort is stable, so same-year entries keep file order.
const sorted = [...publications].sort((a, b) => b.year - a.year);

const years = [...new Set(sorted.map((p) => p.year))];
const groups = years.map((year) => ({ year, items: sorted.filter((p) => p.year === year) }));

const topics = [...new Set(sorted.flatMap((p) => p.tags ?? []))].sort((a, b) => a.localeCompare(b));
---
<div data-pub-list data-total={sorted.length}>
  {topics.length > 0 && (
    <div class="filter" data-filter hidden role="group" aria-label="Filter publications by topic">
      <button type="button" class="tag filter__btn" data-tag="all" aria-pressed="true">All</button>
      {topics.map((t) => (
        <button type="button" class="tag filter__btn" data-tag={slug(t)} aria-pressed="false">{t}</button>
      ))}
    </div>
  )}
  <p class="meta filter__status" data-status aria-live="polite"></p>

  {groups.map((g) => (
    <section class="year-group" aria-labelledby={`year-${g.year}`}>
      <h2 class="year" id={`year-${g.year}`}>{g.year}</h2>
      <ul class="plain-list entries">
        {g.items.map((pub) => <PublicationEntry pub={pub} />)}
      </ul>
    </section>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-pub-list]');
  const bar = root?.querySelector<HTMLElement>('[data-filter]');

  if (root && bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const entries = [...root.querySelectorAll<HTMLElement>('.entry')];
    const groups = [...root.querySelectorAll<HTMLElement>('.year-group')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    const apply = (tag: string) => {
      let shown = 0;
      for (const entry of entries) {
        const match = tag === 'all' || (entry.dataset.tags ?? '').split(' ').includes(tag);
        entry.hidden = !match;
        if (match) shown++;
      }
      // Hide a year marker when every entry under it is filtered out.
      for (const group of groups) group.hidden = !group.querySelector('.entry:not([hidden])');
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.tag === tag));
      status.textContent = tag === 'all' ? '' : `Showing ${shown} of ${entries.length} publications`;
    };

    bar.hidden = false;
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.tag ?? 'all'));
  }
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .filter__btn {
    cursor: pointer;
  }
  .filter__btn:hover,
  .filter__btn[aria-pressed='true'] {
    background: var(--andes);
    color: var(--paper);
  }
  .filter__status {
    margin: var(--space-1) 0 0;
    min-height: 24px;
  }
  .year-group + .year-group {
    margin-top: var(--space-4);
  }
  .year-group .entries {
    margin-top: var(--space-2);
  }

  /* Two columns from 720px: year marker on the left, entries on the right. */
  @media (min-width: 720px) {
    .year-group {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      column-gap: var(--space-3);
    }
    .year-group .entries {
      margin-top: 0;
      /* Keeps lines near the 62–70 character measure on the wide shell. */
      max-width: 640px;
    }
  }
</style>
