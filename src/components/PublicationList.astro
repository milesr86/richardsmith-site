---
// The Publications list: newest first, one raised box per year, with topic
// buttons that filter it. The filter is a few lines of plain JS; with
// JavaScript off the buttons never appear and the full list is shown.
import PublicationGroup from './PublicationGroup.astro';
import { slug, groupByYear, type Publication } from '../data/site';

interface Props {
  publications: Publication[];
}
const { publications } = Astro.props;

const groups = groupByYear(publications);
const topics = [...new Set(publications.flatMap((p) => p.tags ?? []))].sort((a, b) => a.localeCompare(b));
---
<div data-pub-list data-total={publications.length}>
  {topics.length > 0 && (
    <div class="filter" data-filter hidden role="group" aria-label="Filter publications by topic">
      <button type="button" class="tag filter__btn" data-tag="all" aria-pressed="true">All</button>
      {topics.map((t) => (
        <button type="button" class="tag filter__btn" data-tag={slug(t)} aria-pressed="false">{t}</button>
      ))}
    </div>
  )}
  <p class="meta filter__status" data-status aria-live="polite"></p>

  {groups.map((g) => <PublicationGroup year={g.year} pubs={g.items} level={2} />)}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-pub-list]');
  const bar = root?.querySelector<HTMLElement>('[data-filter]');

  if (root && bar) {
    const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
    const entries = [...root.querySelectorAll<HTMLElement>('.entry')];
    const groups = [...root.querySelectorAll<HTMLElement>('.year-group')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;

    const apply = (tag: string) => {
      let shown = 0;
      for (const entry of entries) {
        const match = tag === 'all' || (entry.dataset.tags ?? '').split(' ').includes(tag);
        entry.hidden = !match;
        if (match) shown++;
      }
      // Hide a whole box when every entry in it is filtered out.
      for (const group of groups) group.hidden = !group.querySelector('.entry:not([hidden])');
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.tag === tag));
      status.textContent = tag === 'all' ? '' : `Showing ${shown} of ${entries.length} publications`;
    };

    bar.hidden = false;
    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.tag ?? 'all'));
  }
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .filter__btn {
    cursor: pointer;
  }
  .filter__btn:hover,
  .filter__btn[aria-pressed='true'] {
    background: var(--andes);
    color: var(--paper);
  }
  .filter__status {
    margin: var(--space-1) 0 var(--space-2);
    min-height: 24px;
  }
</style>
