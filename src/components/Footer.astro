---
// Footer: three lines, always: who it is, the profile links, the theme slider.
// Rule hairline above. Profile links are plain text with no icons. No
// copyright line and no repeat of the nav. (With JavaScript off the third line
// is hidden, since the slider can't work without it.)
import ExtLink from './ExtLink.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { footerProfiles } from '../data/site';
---
<footer class="footer">
  <div class="shell footer__inner">
    <!-- TODO(placeholder): confirm the affiliation line wording with Richard. -->
    <p class="footer__line">Richard G. Smith · University of Liverpool</p>
    <ul class="plain-list footer__links">
      {footerProfiles.map((p) => <li><ExtLink href={p.href}>{p.label}</ExtLink></li>)}
    </ul>
    <ThemeSwitch />
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
  }
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: var(--space-1);
    padding-block: var(--space-3);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    line-height: 22px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .footer__line {
    margin: 0;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-3);
    row-gap: var(--space-1);
  }
  .footer__inner :global(a) {
    color: var(--muted);
    padding-block: 1px;
  }
  .footer__inner :global(a:hover) {
    color: var(--ink);
  }
</style>
