---
// Light / System / Dark slider: a three-stop track with a thumb that slides
// to the chosen stop. System (the middle stop, and the default) follows the
// visitor's device; Light and Dark override it, and the choice is remembered
// in this browser only (localStorage).
//
// Built on three radio buttons, so keyboard (arrow keys), screen readers and
// tapping any label all work natively; the thumb is just decoration that
// follows `data-selected`. Hidden when JavaScript is off, since it couldn't do
// anything then; the page still follows the system.
const choices = [
  { value: 'light', label: 'Light' },
  { value: 'system', label: 'System' },
  { value: 'dark', label: 'Dark' },
];
---
<fieldset class="theme-switch" data-selected="system">
  <legend class="visually-hidden">Colour theme</legend>
  <span class="theme-switch__label" aria-hidden="true">Theme</span>
  <div class="theme-switch__track">
    <span class="theme-switch__thumb" aria-hidden="true"></span>
    {choices.map((c) => (
      <label class="theme-switch__option">
        <input type="radio" name="theme" value={c.value} checked={c.value === 'system'} />
        <span>{c.label}</span>
      </label>
    ))}
  </div>
</fieldset>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const wrap = document.querySelector<HTMLElement>('.theme-switch');
  const inputs = [...document.querySelectorAll<HTMLInputElement>('.theme-switch input[name="theme"]')];
  const metas = [...document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')];
  const PAPER = { light: '#F5F0E6', dark: '#1A1714' } as const;

  type Choice = 'light' | 'dark' | 'system';

  const read = (): Choice => {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch {
      return 'system';
    }
  };

  const apply = (choice: Choice) => {
    if (choice === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', choice);

    // Keep the browser's address-bar colour in step with the page.
    for (const m of metas) {
      const forDark = (m.getAttribute('media') ?? '').includes('dark');
      m.content = choice === 'system' ? (forDark ? PAPER.dark : PAPER.light) : PAPER[choice];
    }
    if (wrap) wrap.dataset.selected = choice;
    for (const i of inputs) i.checked = i.value === choice;
  };

  if (wrap) {
    apply(read());

    for (const i of inputs) {
      i.addEventListener('change', () => {
        if (!i.checked) return;
        const choice = i.value as Choice;
        try {
          if (choice === 'system') localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, choice);
        } catch {
          /* storage blocked (private window): the choice still applies for this visit */
        }
        apply(choice);
      });
    }
  }
</script>

<style>
  .theme-switch {
    display: none;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  :global(.js) .theme-switch {
    display: flex;
    align-items: center;
    column-gap: var(--space-2);
  }
  .theme-switch__label {
    color: var(--muted);
  }

  /* The track: a flat, square, three-stop bar. */
  .theme-switch__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 228px;
    max-width: 100%;
    border: 1px solid var(--muted);
  }

  /* The thumb: one third of the track, slides to the chosen stop. */
  .theme-switch__thumb {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(100% / 3);
    background: var(--ink);
    transition: transform 160ms ease-out;
  }
  .theme-switch[data-selected='system'] .theme-switch__thumb { transform: translateX(100%); }
  .theme-switch[data-selected='dark'] .theme-switch__thumb { transform: translateX(200%); }
  @media (prefers-reduced-motion: reduce) {
    .theme-switch__thumb { transition: none; }
  }

  .theme-switch__option {
    position: relative;
    z-index: 1; /* above the thumb, so the labels stay readable on it */
    display: block;
    min-height: 34px;
    cursor: pointer;
  }
  /* The real radio covers the whole stop, invisibly, so a tap anywhere on it counts. */
  .theme-switch__option input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .theme-switch__option span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 34px;
    color: var(--muted);
  }
  .theme-switch__option:hover span {
    color: var(--ink);
  }
  /* The chosen stop sits on the ink thumb, so its label flips to paper. */
  .theme-switch__option input:checked + span,
  .theme-switch__option:hover input:checked + span {
    color: var(--paper);
  }
  .theme-switch__option input:focus-visible + span {
    outline: 2px solid var(--poster-red);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
