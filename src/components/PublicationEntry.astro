---
// Publication entry. Article title in roman with double quotes, at body size
// (the proposal's presentation; list titles in 21px semibold read too heavy for
// long scholarly titles); journal and book titles italic in the meta line;
// co-authors in the order the journal prints them. DOI (and repository copy,
// where there is one) open in a new tab and carry an arrow. Renders a <li>:
// put it inside a <ul class="plain-list"> (see PublicationGroup).
import ExtLink from './ExtLink.astro';
import { slug, type Publication } from '../data/site';

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
const tags = pub.tags ?? [];
// A book title is italic with no quotes; everything else is roman in quotes.
const isBook = pub.kind === 'book';
// Volume-style details ("102(6), 571–582") follow the venue after a space;
// anything else ("pp. 81–128", "June 2024", "no. 9", "108–118") after a comma.
const sep = pub.detail && /^\d+(\(\d+\))?,/.test(pub.detail) ? ' ' : ', ';
---
<li class="entry" data-tags={tags.map(slug).join(' ')}>
  <p class="entry__title">{isBook ? <em>{pub.title}</em> : <>“{pub.title}”</>}</p>
  <p class="meta">
    {pub.authors} · <em>{pub.journal}</em>{pub.detail ? `${sep}${pub.detail}` : ''}{pub.doi && <> · <ExtLink href={pub.doi}>DOI</ExtLink></>}{!pub.doi && pub.url && <> · <ExtLink href={pub.url}>{pub.urlLabel ?? 'Link'}</ExtLink></>}{pub.repository && <> · <ExtLink href={pub.repository}>Repository</ExtLink></>}
  </p>
  {tags.length > 0 && (
    <ul class="plain-list tags" aria-label="Topics">
      {tags.map((t) => <li><span class="tag">{t}</span></li>)}
    </ul>
  )}
</li>

<style>
  /* Entries are 32px apart in total: 16px, the hairline, 16px. */
  .entry + .entry {
    margin-top: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--rule);
  }
  .entry__title {
    margin: 0 0 var(--space-1);
    font-size: 18px;
    line-height: 28px;
  }
  .entry .meta {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }
</style>
