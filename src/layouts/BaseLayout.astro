---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { siteName } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Path of the nav item to mark as the current page, e.g. "/projects/". */
  current?: string;
  /** "read" = 720px reading column, "wide" = 960px grids. */
  width?: 'read' | 'wide';
}

// TODO(placeholder): default description is generic; write a real one.
const {
  title,
  description = 'Personal research website of Dr Richard G. Smith, historian, University of Liverpool.',
  current = '',
  width = 'read',
} = Astro.props;

const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F5F0E6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#110F0D" media="(prefers-color-scheme: dark)" />

    <!-- TODO(placeholder): this is an unpublished draft with dummy content, so
         search engines are told to stay away. Delete this tag at launch. -->
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary" />
    <!-- TODO(placeholder): og:url / og:image need the domain and the RGS-on-sun
         social card, neither of which exists yet. -->

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Lets the CSS tell "JavaScript is running" (burger menu) from "it isn't"
         (links just show), with no flash of the wrong one. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Apply a saved Light/Dark choice before first paint, so a returning
      // visitor never sees a flash of the other theme.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Masthead current={current} />
    <main id="main">
      <div class={`shell shell--${width}`}>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
