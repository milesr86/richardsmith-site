---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
---
<BaseLayout
  title="Projects"
  description="Current projects: Tallersol: Memories of Resistance, and Migration, Music and Memory."
  current="/projects/"
  width="wide"
>
  <div class="section">
    <h1>Projects</h1>
    <!-- TODO(approval): intro line is Miles's wording, built from Richard's project texts. -->
    <p class="measure">Two current projects: digitising the poster collection of the <span lang="es">Tallersol</span> workshop in Santiago, and work on music, migration and memory with communities in Liverpool.</p>
  </div>

  <div class="section">
    <div class="card-grid">
      <ProjectCard href={projects[0].href} eyebrow={projects[0].eyebrow} strand={projects[0].strand} level={2}>
        <Fragment slot="title"><span lang="es">Tallersol</span>: Memories of Resistance</Fragment>
        {projects[0].line}
      </ProjectCard>
      <ProjectCard href={projects[1].href} eyebrow={projects[1].eyebrow} strand={projects[1].strand} level={2}>
        <Fragment slot="title">Migration, Music and Memory</Fragment>
        {projects[1].line}
      </ProjectCard>
    </div>
  </div>
</BaseLayout>

<style>
  .card-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
