---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationGroup from '../../components/PublicationGroup.astro';
import { para } from '../../data/lorem';
import data from '../../data/publications.json';
import { slug, groupByYear, type Publication } from '../../data/site';

// Related outputs are pulled from the publications list by topic tag, so
// there is still only one list to maintain.
const related = [...(data.publications as Publication[])]
  .filter((p) => (p.tags ?? []).some((t) => slug(t) === 'music'))
  .sort((a, b) => b.year - a.year)
  .slice(0, 3);
const relatedGroups = groupByYear(related);
---
<BaseLayout
  title="Migration, Music and Memory"
  description="Migration, Music and Memory, a community research project in Liverpool."
  current="/projects/"
  width="read"
>
  <div class="section">
    <!-- TODO(placeholder): eyebrow is dummy; all copy on this page is lorem ipsum. -->
    <p class="eyebrow">Community · ongoing</p>
    <h1>Migration, Music and Memory</h1>
    <p>{para[0]}</p>
    <p>{para[1]}</p>
  </div>

  <section class="section" aria-labelledby="mmm-communities">
    <!-- TODO(placeholder): invented section heading; replace or remove. -->
    <h2 id="mmm-communities">Communities and partners</h2>
    <p>{para[2]}</p>
  </section>

  <section class="section" aria-labelledby="mmm-related">
    <!-- TODO(placeholder): invented section heading; replace or remove. -->
    <h2 id="mmm-related">Related publications</h2>
    {relatedGroups.map((g) => <PublicationGroup year={g.year} pubs={g.items} level={3} idPrefix="related" />)}
  </section>

  <p class="back"><a href="/projects/">All projects</a></p>
</BaseLayout>

<style>
  .back { margin-top: var(--space-4); }
</style>
