---
import BaseLayout from '../layouts/BaseLayout.astro';
import PosterFigure from '../components/PosterFigure.astro';
import ExtLink from '../components/ExtLink.astro';
import { profiles } from '../data/site';
---
<BaseLayout
  title="About"
  description="About Dr Richard G. Smith: from chemistry and consumer product innovation to Latin American studies; qualifications, profiles and contact."
  current="/about/"
  width="read"
>
  <div class="section">
    <h1>About</h1>
    <div class="intro">
      <div>
        {/* Richard's About text, as supplied. */}
        <h2 id="about-background">Background</h2>
        <p>I originally trained as a chemist at the Universities of Oxford (MA Oxon) and Sussex (DPhil) before embarking on a career in consumer product innovation with Unilever that took me all over the world, including spells living and working in Buenos Aires and Den Haag, and many years working and travelling across the length and breadth of Latin America. My fifteen years’ experience commercially exploiting technology in laundry products with Unilever was put to good use during five years working in government devising and delivering practical and commercial support to companies in Yorkshire &amp; Humber.</p>
        <p>During my professional career in science and innovation, I also studied Spanish, French and History at the Open University and then obtained an MA in Latin American Studies from the University of Liverpool in 2016. I continued at Liverpool for my doctoral studies, and my PhD was awarded in 2022. My thesis concerned the student opposition to the Pinochet regime in Chile and was subsequently published by Palgrave Macmillan in 2024.</p>
        <p>In addition, I was awarded a University of Georgia Franklin College – University of Liverpool International Research Fellowship in 2017, and I was a Visiting Fellow at CLACS, University of London (2022–23). As well as continuing my doctoral research interests, I am part of a project digitising a collection of political posters in Santiago, and one exploring music, migration and identity with Chilean exiles and other migrant communities in Liverpool.</p>
      </div>
      {/* TODO(pending): portrait not supplied yet (style guide, open item 13).
           Natural light, no studio backdrop, no filter. */}
      <PosterFigure
        label="Portrait"
        alt="Placeholder alt text: describe the portrait of Richard."
        caption="Portrait credit goes here."
      />
    </div>
  </div>

  {/* TODO(pending): the style guide plans a short Spanish summary on About
       for launch. None supplied; ask Richard (open item 12). */}

  <section class="section" aria-labelledby="about-qualifications">
    <h2 id="about-qualifications">Qualifications</h2>
    {/* From Richard's "Quals - Profiles - Contact.docx", in his order. Post-nominals
         live here once and nowhere else, per the style guide. */}
    <h3>Degrees</h3>
    <ul class="bullets">
      <li>BA in Natural Sciences (Second Class, 1984) and MA (Oxon) (1987), St Catherine’s College, University of Oxford, 1980–1984. Open Exhibition (1980–1984); Turbett Prize (1983).</li>
      <li>DPhil in Inorganic Chemistry, University of Sussex, 1987, supervised by Professor Michael F. Lappert FRS. Thesis: <em>Neutral Homoleptic Alkyls of Yttrium and the 4f Elements</em>.</li>
      <li>BA (Honours) Open in Spanish, French and History (Upper Second Class, 2010), The Open University, 2003–2010.</li>
      <li>MA in Latin American Studies with Distinction (2016), University of Liverpool. <span lang="es">José Herrera Oropeza</span> Prize I (2015).</li>
      <li>PhD in Latin American Studies (2022), University of Liverpool, supervised by Drs Andrew Redden and Marieke Riethof. Thesis: <em>‘Security to study, freedom to live!’: School and University Student Resistance to Military Dictatorship in Chile, 1973–1990</em>.</li>
    </ul>

    <h3>Fellowships and diploma</h3>
    <ul class="bullets">
      <li>Fellow of the Royal Society of Chemistry, FRSC (2010).</li>
      <li>Fellow of the Royal Historical Society, FRHistS (2025).</li>
      <li>Associate Fellow of the Higher Education Academy, AFHEA, AdvanceHE (2021).</li>
      <li><span lang="es">Diploma de Español como Lengua Extranjera, Nivel Intermedio</span>, <span lang="es">Instituto Cervantes</span> (2005).</li>
    </ul>
  </section>

  <section class="section" aria-labelledby="about-activities">
    <h2 id="about-activities">Professional activities</h2>
    {/* From Richard's "Professional.docx". */}
    {/* TODO(check): the ESRC studentship (2018–2021) overlaps the Impact Postdoctoral
         post (2018–2020). Ask Richard to confirm both. */}
    <ul class="bullets">
      <li>University of Georgia Franklin College – University of Liverpool International Research Fellowship (2017)</li>
      <li>Awarded ‘+2’ studentship with ESRC-funded NWSSDTP (2018–2021)</li>
      <li>President of PILAS (Postgraduates in Latin American Studies: PGR wing of SLAS) (2016–2017)</li>
      <li>Co-organiser of the fifth UK Latin America History Network conference (Liverpool, 2025)</li>
      <li>Impact Postdoctoral Research Associate (HSS Faculty) (2018–2020)</li>
    </ul>
  </section>

  <section class="section" aria-labelledby="about-profiles">
    <h2 id="about-profiles">Profiles</h2>
    <ul class="plain-list profiles">
      {profiles.map((p) => <li><ExtLink href={p.href}>{p.label}</ExtLink></li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="about-contact">
    <h2 id="about-contact">Contact</h2>
    {/* TODO(check): supplied by Richard; confirm it is the address he wants public
         (the style guide describes him as an honorary fellow). */}
    <p><a href="mailto:richard.smith@liverpool.ac.uk">richard.smith@liverpool.ac.uk</a></p>
  </section>
</BaseLayout>

<style>
  .intro {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1fr);
  }
  .intro :global(.poster) {
    max-width: 240px;
  }
  @media (min-width: 720px) {
    .intro { grid-template-columns: minmax(0, 1fr) 240px; }
  }
  .profiles {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-3);
    row-gap: var(--space-1);
  }
</style>
