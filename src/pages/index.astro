---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedBook from '../components/FeaturedBook.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PublicationGroup from '../components/PublicationGroup.astro';
import { projects } from '../data/projects';
import data from '../data/publications.json';
import { groupByYear, type Publication } from '../data/site';

// "Recent work" is Richard's own four picks (`featured` in publications.json),
// so there is still only one list to maintain.
const recent = (data.publications as Publication[]).filter((p) => p.featured);
const recentGroups = groupByYear(recent);
---
<BaseLayout title="Richard G. Smith" current="/" width="read">
  <div class="section">
    <h1>Richard G. Smith</h1>
    <!-- TODO(approval): DRAFT lede, written by Miles from Richard's own wording
         (his Homepage text is a ~110-word third-person bio, so it was not used).
         Not for launch until Richard or Miles has approved it. -->
    <p class="lede">I research student opposition to the Pinochet regime in Chile, and, with colleagues, work on a digitised archive of Chilean protest posters and on music, migration and identity in Liverpool.</p>

    <div class="home-book">
      <FeaturedBook
        title="Student Resistance to Dictatorship in Chile, 1973–1990: ‘Security to Study, Freedom to Live!’"
        publisher="Palgrave Macmillan, 2024"
        href="https://link.springer.com/book/10.1007/978-3-031-64384-2"
        doi="https://doi.org/10.1007/978-3-031-64384-2"
        isbns={[
          { label: 'Hardcover', value: '978-3-031-64383-5' },
          { label: 'Softcover', value: '978-3-031-64386-6' },
          { label: 'eBook', value: '978-3-031-64384-2' },
        ]}
        quote="Smith illuminates a still-obscure period in Chile, and the book is an interesting and welcome addition to the literature on dictatorship and resistance in Latin America."
        quoteBy="J. Patrice McSherry"
      />
    </div>
  </div>

  <section class="section" aria-labelledby="home-projects">
    <h2 id="home-projects">Projects</h2>
    <div class="card-grid">
      <ProjectCard href={projects[0].href} eyebrow={projects[0].eyebrow} strand={projects[0].strand}>
        <Fragment slot="title"><span lang="es">Tallersol</span>: Memories of Resistance</Fragment>
        {projects[0].line}
      </ProjectCard>
      <ProjectCard href={projects[1].href} eyebrow={projects[1].eyebrow} strand={projects[1].strand}>
        <Fragment slot="title">Migration, Music and Memory</Fragment>
        {projects[1].line}
      </ProjectCard>
    </div>
  </section>

  <section class="section" aria-labelledby="home-recent">
    <h2 id="home-recent">Recent work</h2>
    {recentGroups.map((g) => <PublicationGroup year={g.year} pubs={g.items} level={3} idPrefix="recent" />)}
    <p class="home-all"><a href="/publications/">All publications</a></p>
  </section>
</BaseLayout>

<style>
  .home-book { margin-top: var(--space-3); }
  .card-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 720px) {
    .card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .home-all { margin-top: var(--space-3); }
</style>
